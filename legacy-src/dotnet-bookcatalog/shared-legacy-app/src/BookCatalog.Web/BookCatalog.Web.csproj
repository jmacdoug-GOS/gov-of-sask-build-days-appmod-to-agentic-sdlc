<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BookCatalog.Web</RootNamespace>
    <AssemblyName>BookCatalog.Web</AssemblyName>
  </PropertyGroup>

  <!-- Task 001 only: classic files stay on disk until tasks 002-003 migrate or delete them. -->
  <ItemGroup>
    <Compile Remove="App_Start\**" />
    <Compile Remove="Controllers\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Global.asax.cs" />
    <Content Remove="Views\**" />
    <Content Remove="Web.config" />
    <Content Remove="Global.asax" />
    <None Remove="Views\**" />
    <None Remove="Web.config" />
    <None Remove="Global.asax" />
    <None Remove="Global.asax.cs" />
  </ItemGroup>

</Project>
